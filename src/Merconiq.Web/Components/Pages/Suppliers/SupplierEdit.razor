@page "/Suppliers/Edit/{Id:int}"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Merconiq.Web.Security
@attribute [Authorize(Policy = CapabilityPolicies.Edit)]
@inject ISupplierService SupplierService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ICurrentUserAuthorization CurrentUserAuthorization
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<PageTitle>Edit Supplier</PageTitle>

@if (_message is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-3">@_message</MudAlert>
}

<MudText Typo="Typo.h4" Color="Color.Primary" Class="mb-3">Edit Supplier</MudText>
<MudDivider Class="mb-4" />

@if (_supplier == null)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
}
else
{
    <MudGrid>
        <MudItem xs="12" md="6">
            <MudPaper Elevation="1" Class="pa-4">
                <EditForm Model="@_supplier" OnValidSubmit="OnValidSubmit">
                    <DataAnnotationsValidator />
                    <MudTextField @bind-Value="_supplier.Name" Label="Name" Required="true" For="@(() => _supplier.Name)" Class="mb-3" />
                    <MudTextField @bind-Value="_supplier.ContactPerson" Label="Contact Person" For="@(() => _supplier.ContactPerson)" Class="mb-3" />
                    <MudTextField @bind-Value="_supplier.Phone" Label="Phone" For="@(() => _supplier.Phone)" Class="mb-3" />
                    <MudTextField @bind-Value="_supplier.Email" Label="Email" For="@(() => _supplier.Email)" Class="mb-3" />
                    <MudTextField @bind-Value="_supplier.Address" Label="Address" Lines="3" For="@(() => _supplier.Address)" Class="mb-3" />

                    <div class="d-flex gap-2 mt-4">
                        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">Save Changes</MudButton>
                        <MudButton Href="/Suppliers" Variant="Variant.Outlined" Color="Color.Secondary">Cancel</MudButton>
                    </div>
                </EditForm>
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private Supplier? _supplier;
    private string? _message;

    protected override async Task OnInitializedAsync()
    {
        var principal = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        if (!await CurrentUserAuthorization.HasCompanyCapabilityAsync(principal, CompanyCapability.Edit))
        {
            _message = "An active Edit grant is required to change shared supplier masters.";
            return;
        }

        _supplier = await SupplierService.GetByIdAsync(Id);
    }

    private async Task OnValidSubmit()
    {
        if (_supplier != null)
        {
            try
            {
                var principal = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
                if (!await CurrentUserAuthorization.HasCompanyCapabilityAsync(principal, CompanyCapability.Edit))
                {
                    _message = "Your Edit grant is no longer active.";
                    return;
                }

                await SupplierService.UpdateAsync(_supplier);
                Snackbar.Add("Supplier updated successfully", Severity.Success);
                Nav.NavigateTo("/Suppliers");
            }
            catch (Exception ex)
            {
                _message = ex.Message;
            }
        }
    }
}
