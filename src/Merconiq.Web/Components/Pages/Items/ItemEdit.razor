@page "/Items/Edit/{Id:int}"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Merconiq.Web.Security
@attribute [Authorize(Policy = CapabilityPolicies.Edit)]
@inject IItemService ItemService
@inject ISupplierService SupplierService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ICurrentUserAuthorization CurrentUserAuthorization
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<PageTitle>Edit Item</PageTitle>

@if (_message is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-3">@_message</MudAlert>
}

<MudText Typo="Typo.h4" Color="Color.Primary" Class="mb-3">Edit Item</MudText>
<MudDivider Class="mb-4" />

@if (_item == null)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
}
else
{
    <MudGrid>
        <MudItem xs="12" md="6">
            <MudPaper Elevation="1" Class="pa-4">
                <EditForm Model="@_item" OnValidSubmit="OnValidSubmit">
                    <DataAnnotationsValidator />
                    <MudTextField @bind-Value="_item.ItemCode" Label="Item Code" Required="true" For="@(() => _item.ItemCode)" Class="mb-3" />
                    <MudTextField @bind-Value="_item.Barcode" Label="Barcode (SKU/EAN)" Placeholder="Scan or enter barcode" For="@(() => _item.Barcode)" Class="mb-3" />
                    <MudTextField @bind-Value="_item.Description" Label="Description" Required="true" For="@(() => _item.Description)" Class="mb-3" />
                    <MudNumericField @bind-Value="_item.Rate" Label="Rate" Format="N2" Required="true" For="@(() => _item.Rate)" Class="mb-3" />
                    <MudSelect T="int?" @bind-Value="_item.SupplierId" Label="Supplier" AnchorOrigin="Origin.BottomCenter" Class="mb-3">
                        <MudSelectItem T="int?" Value="null">-- Select Supplier --</MudSelectItem>
                        @foreach (var supplier in _suppliers)
                        {
                            <MudSelectItem T="int?" Value="(int?)supplier.Id">@supplier.Name</MudSelectItem>
                        }
                    </MudSelect>

                    <div class="d-flex gap-2 mt-4">
                        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">Save Changes</MudButton>
                        <MudButton Href="/Items" Variant="Variant.Outlined" Color="Color.Secondary">Cancel</MudButton>
                    </div>
                </EditForm>
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private Item? _item;
    private IEnumerable<Supplier> _suppliers = new List<Supplier>();
    private string? _message;

    protected override async Task OnInitializedAsync()
    {
        var principal = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        if (!await CurrentUserAuthorization.HasCompanyCapabilityAsync(principal, CompanyCapability.Edit))
        {
            _message = "An active Edit grant is required to change shared item masters.";
            return;
        }

        _suppliers = await SupplierService.GetAllAsync();
        _item = await ItemService.GetByIdAsync(Id);
    }

    private async Task OnValidSubmit()
    {
        if (_item != null)
        {
            try
            {
                var principal = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
                if (!await CurrentUserAuthorization.HasCompanyCapabilityAsync(principal, CompanyCapability.Edit))
                {
                    _message = "Your Edit grant is no longer active.";
                    return;
                }

                await ItemService.UpdateAsync(_item);
                Snackbar.Add("Item updated successfully", Severity.Success);
                Nav.NavigateTo("/Items");
            }
            catch (Exception ex)
            {
                _message = ex.Message;
            }
        }
    }
}
