@page "/Organization/Companies/{CompanyId:int}/Branches/Create"
@page "/Organization/Branches/Edit/{Id:int}"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Merconiq.Core.Models
@using Merconiq.Web.Security
@attribute [Authorize(Policy = CapabilityPolicies.Edit)]
@inject IOrganizationService OrganizationService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject CurrentUserAuthorization CurrentUserAuthorization
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject ILogger<BranchForm> Logger

<PageTitle>@(IsEdit ? "Edit branch" : "Create branch")</PageTitle>

<MudStack Spacing="1" Class="mb-4">
    <MudText Typo="Typo.h4">@(IsEdit ? "Edit branch" : "Create branch")</MudText>
    @if (_company is not null)
    {
        <MudText Typo="Typo.body2" Color="Color.Secondary">@_company.LegalName <span aria-hidden="true">·</span> @_company.Code</MudText>
    }
</MudStack>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" aria-label="Loading branch" />
}
else if (_loadErrorMessage is not null)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@_loadErrorMessage</MudAlert>
    <MudButton Color="Color.Primary" Variant="Variant.Text" Class="mt-3" OnClick="RetryLoadAsync">Retry</MudButton>
}
else if (_notFound || _company is null)
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">Branch or company not found in this tenant.</MudAlert>
    <MudButton Href="/Organization/Companies" Color="Color.Primary" Variant="Variant.Text" Class="mt-3">Back to companies</MudButton>
}
else if (!_company.IsActive && !IsEdit)
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
        A branch cannot be created for an inactive company.
    </MudAlert>
    <MudButton Href="@($"/Organization/Companies/{_company.Id}/Branches")" Color="Color.Primary" Variant="Variant.Text" Class="mt-3">
        Back to branches
    </MudButton>
}
else
{
    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-4">@_errorMessage</MudAlert>
    }

    @if (!_company.IsActive)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mb-4">
            This company is inactive. Branch details may be reviewed, but the branch cannot be activated.
        </MudAlert>
    }

    <MudPaper Outlined="true" Class="pa-4 pa-md-6">
        <MudForm @ref="_form" ValidationDelay="0">
            <MudGrid Spacing="3">
                <MudItem xs="12" md="6">
                    @if (IsEdit)
                    {
                        <MudTextField T="string" Label="Branch code" Value="@_model.Code" ReadOnly="true"
                                      HelperText="Branch code and company ownership are immutable after creation." />
                    }
                    else
                    {
                        <MudTextField T="string" Label="Branch code" @bind-Value="_model.Code"
                                      Required="true" RequiredError="Branch code is required."
                                      MaxLength="32" Counter="32" Immediate="true" />
                    }
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField T="string" Label="Branch name" @bind-Value="_model.Name"
                                  Required="true" RequiredError="Branch name is required."
                                  MaxLength="200" Counter="200" Immediate="true" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField T="string" Label="Address (optional)" @bind-Value="_model.Address"
                                  MaxLength="500" Counter="500" Lines="2" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField T="string" Label="Time zone" @bind-Value="_model.TimeZoneId"
                                  Required="true" RequiredError="Time zone is required."
                                  MaxLength="100" Counter="100"
                                  HelperText="Use the approved time-zone identifier for this branch." />
                </MudItem>
                @if (IsEdit)
                {
                    <MudItem xs="12">
                        <MudSwitch T="bool" @bind-Value="_model.IsActive" Color="Color.Success" Label="Branch is active"
                                   Disabled="@(!_company.IsActive && !_model.IsActive)" />
                        @if (!_model.IsActive)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                Locations must be reassigned before this branch can be deactivated.
                            </MudText>
                        }
                    </MudItem>
                }
            </MudGrid>
        </MudForm>

        <MudDivider Class="my-4" />
        <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="@_saving">
                @(_saving ? "Saving…" : IsEdit ? "Save changes" : "Create branch")
            </MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Default"
                       Href="@($"/Organization/Companies/{_company.Id}/Branches")" Disabled="@_saving">
                Cancel
            </MudButton>
        </MudStack>
    </MudPaper>
}

@code {
    [Parameter] public int? CompanyId { get; set; }
    [Parameter] public int? Id { get; set; }

    private MudForm? _form;
    private BranchFormModel _model = new();
    private Company? _company;
    private string? _errorMessage;
    private string? _loadErrorMessage;
    private bool _loading = true;
    private bool _notFound;
    private bool _saving;
    private bool IsEdit => Id.HasValue;

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }

    private Task RetryLoadAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _notFound = false;
        _errorMessage = null;
        _loadErrorMessage = null;
        _company = null;
        _model = new BranchFormModel();
        try
        {
            var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            if (Id is int id)
            {
                if (!await CurrentUserAuthorization.CanAccessBranchAsync(
                        authenticationState.User, id, CompanyCapability.View))
                {
                    _notFound = true;
                    return;
                }

                var branch = await OrganizationService.GetBranchAsync(id);
                if (branch is null)
                {
                    _notFound = true;
                    return;
                }

                _company = await OrganizationService.GetCompanyAsync(branch.CompanyId);
                if (_company is null)
                {
                    _notFound = true;
                    return;
                }

                _model = new BranchFormModel
                {
                    Code = branch.Code,
                    Name = branch.Name,
                    Address = branch.Address,
                    TimeZoneId = branch.TimeZoneId,
                    IsActive = branch.IsActive
                };
            }
            else if (CompanyId is int companyId)
            {
                if (!await CurrentUserAuthorization.CanAccessCompanyAsync(
                        authenticationState.User, companyId, CompanyCapability.View))
                {
                    _notFound = true;
                    return;
                }

                _company = await OrganizationService.GetCompanyAsync(companyId);
                _model = new BranchFormModel();
            }
            else
            {
                _notFound = true;
            }
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Unable to load branch {BranchId} or company {CompanyId}.", Id, CompanyId);
            _loadErrorMessage = "Unable to load branch details. Please retry.";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SaveAsync()
    {
        if (_form is null || _company is null || _saving)
            return;

        await _form.ValidateAsync();
        if (!_form.IsValid)
        {
            _errorMessage = "Review the highlighted fields and try again.";
            return;
        }

        _saving = true;
        _errorMessage = null;
        try
        {
            var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var canSave = Id is int branchId
                ? await CurrentUserAuthorization.CanAccessBranchAsync(
                    authenticationState.User, branchId, CompanyCapability.Edit)
                : await CurrentUserAuthorization.CanAccessCompanyAsync(
                    authenticationState.User, _company.Id, CompanyCapability.Edit);
            if (!canSave)
            {
                _errorMessage = "Your session or organization-management permissions changed. Sign in again or contact an administrator.";
                Snackbar.Add(_errorMessage, Severity.Error);
                return;
            }

            if (Id is int id)
            {
                await OrganizationService.UpdateBranchAsync(id, new UpdateBranchRequest(
                    _model.Name, _model.Address, _model.TimeZoneId, _model.IsActive));
                Snackbar.Add("Branch updated.", Severity.Success);
            }
            else
            {
                await OrganizationService.CreateBranchAsync(new CreateBranchRequest(
                    _company.Id, _model.Code, _model.Name, _model.Address, _model.TimeZoneId));
                Snackbar.Add("Branch created.", Severity.Success);
            }

            Navigation.NavigateTo($"/Organization/Companies/{_company.Id}/Branches");
        }
        catch (Exception exception)
        {
            Logger.LogWarning(exception, "Unable to save branch changes.");
            _errorMessage = exception is ArgumentException or InvalidOperationException
                ? exception.Message
                : "Unable to save branch changes. Please retry.";
            Snackbar.Add(_errorMessage, Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private sealed class BranchFormModel
    {
        public string Code { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public string? Address { get; set; }
        public string TimeZoneId { get; set; } = string.Empty;
        public bool IsActive { get; set; } = true;
    }
}
