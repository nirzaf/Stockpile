@page "/Locations"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Merconiq.Web.Security
@attribute [Authorize(Policy = CapabilityPolicies.View)]
@inject ILocationService LocationService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ICurrentUserAuthorization CurrentUserAuthorization
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Locations</PageTitle>

<div class="d-flex justify-space-between align-center mb-4">
    <MudText Typo="Typo.h4" Color="Color.Primary">Locations</MudText>
    @if (_canCreate)
    {
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/Locations/Create">Add New Location</MudButton>
    }
</div>

@if (_message is not null)
{
    <MudAlert Severity="Severity.Info" Class="mb-3">@_message</MudAlert>
}

<MudTable Items="@_locations" Dense="true" Hover="true" Striped="true" Filter="new Func<Location,bool>(FilterFunc)">
    <ToolBarContent>
        <MudSpacer />
        <MudTextField @bind-Value="_searchString" Placeholder="Search" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
    </ToolBarContent>
    <HeaderContent>
        <MudTh><MudTableSortLabel SortBy="new Func<Location, object>(x=>x.Name)">Name</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel SortBy="new Func<Location, object>(x=>x.Address ?? string.Empty)">Address</MudTableSortLabel></MudTh>
        <MudTh Style="text-align:right">Actions</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Name">@context.Name</MudTd>
        <MudTd DataLabel="Address">@context.Address</MudTd>
        <MudTd DataLabel="Actions" Style="text-align:right">
            @if (_manageableLocationIds.Contains(context.Id))
            {
                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning" Href="@($"/Locations/Edit/{context.Id}")" Class="mr-2">Edit</MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" OnClick="@(() => DeleteLocation(context))">Delete</MudButton>
            }
        </MudTd>
    </RowTemplate>
    <PagerContent>
        <MudTablePager />
    </PagerContent>
</MudTable>

@code {
    private IEnumerable<Location> _locations = new List<Location>();
    private readonly HashSet<int> _manageableLocationIds = [];
    private string _searchString = "";
    private string? _message;
    private bool _canCreate;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        var principal = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        var isTenantAdmin = await CurrentUserAuthorization.IsTenantAdministratorAsync(principal);
        var accessibleCompanyIds = await CurrentUserAuthorization.GetAccessibleCompanyIdsAsync(
            principal, CompanyCapability.View);
        _locations = isTenantAdmin
            ? await LocationService.GetAllAsync()
            : await LocationService.GetForCompaniesAsync(accessibleCompanyIds.ToArray());
        _manageableLocationIds.Clear();
        foreach (var location in _locations)
        {
            if (await CurrentUserAuthorization.CanAccessLocationAsync(
                    principal, location.Id, CompanyCapability.Administer))
            {
                _manageableLocationIds.Add(location.Id);
            }
        }

        _canCreate = (await CurrentUserAuthorization.GetAccessibleCompanyIdsAsync(
            principal, CompanyCapability.Administer)).Count > 0;
        _message = _locations.Any()
            ? null
            : "No locations are assigned to your companies. Legacy unassigned locations are visible only to a tenant administrator.";
    }

    private bool FilterFunc(Location element) => FilterFunc(element, _searchString);

    private bool FilterFunc(Location element, string searchString)
    {
        if (string.IsNullOrWhiteSpace(searchString)) return true;
        if (element.Name.Contains(searchString, StringComparison.OrdinalIgnoreCase)) return true;
        if (element.Address?.Contains(searchString, StringComparison.OrdinalIgnoreCase) == true) return true;
        return false;
    }

    private async Task DeleteLocation(Location location)
    {
        bool? result = await DialogService.ShowMessageBoxAsync(
            "Warning", 
            $"Are you sure you want to delete {location.Name}?", 
            yesText: "Delete!", cancelText: "Cancel");

        if (result == true)
        {
            try
            {
                var principal = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
                if (!await CurrentUserAuthorization.CanAccessLocationAsync(
                        principal, location.Id, CompanyCapability.Administer))
                {
                    Snackbar.Add("You are no longer authorized to administer this location.", Severity.Error);
                    await LoadDataAsync();
                    return;
                }

                await LocationService.DeleteAsync(location.Id);
                Snackbar.Add("Location deleted successfully", Severity.Success);
                await LoadDataAsync();
            }
            catch (Exception ex)
            {
                Snackbar.Add(ex.Message, Severity.Error);
            }
        }
    }
}
