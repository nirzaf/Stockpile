@page "/PurchaseOrders/Details/{Id:int}"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using Merconiq.Core.Models
@using Merconiq.Web.Security
@attribute [Authorize(Policy = CapabilityPolicies.TenantAdministrator)]
@inject IPurchaseOrderService POService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ICurrentUserAuthorization CurrentUserAuthorization
@inject IStringLocalizer<SharedResource> L
@inject NavigationManager Nav

<PageTitle>Purchase Order Details</PageTitle>

<MudText Typo="Typo.h4" HtmlTag="h1" Color="Color.Primary" Class="mb-3">Purchase Order Details</MudText>
<MudDivider Class="mb-4" />

@if (_statusFeedback is not null)
{
    <div class="status-feedback-focus mb-3" tabindex="-1" @ref="_statusFeedbackFocusTarget">
        <MudAlert Severity="@_statusFeedbackSeverity"
                  Variant="Variant.Outlined"
                  Class="document-status-feedback"
                  role="@StatusFeedbackRole"
                  aria-live="@StatusFeedbackLive">
            <div>@_statusFeedback</div>
            @if (_showStatusReload)
            {
                <MudButton Variant="Variant.Text"
                           Color="Color.Primary"
                           Class="document-action"
                           Disabled="@_isUpdatingStatus"
                           OnClick="ReloadCurrentPurchaseOrder">
                    @L["Reload current purchase order"]
                </MudButton>
            }
        </MudAlert>
    </div>
}

@if (_po is null)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" aria-label="@L["Loading purchase order"]" />
}
else
{
    @if (_po.ApprovedCommercialVersion.HasValue && _po.ApprovedCommercialVersion != _po.CommercialVersion)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-3">
            Commercial version @_po.CommercialVersion is not approved. Version @_po.ApprovedCommercialVersion was last approved; reapproval is required before this order can proceed.
        </MudAlert>
    }

    <MudPaper Elevation="1" Class="pa-4 mb-4">
        <MudGrid>
            <MudItem xs="6" sm="3"><MudText Typo="Typo.subtitle2" Color="Color.Secondary">PO Number</MudText></MudItem>
            <MudItem xs="6" sm="3"><MudText>@_po.PONumber</MudText></MudItem>

            <MudItem xs="6" sm="3"><MudText Typo="Typo.subtitle2" Color="Color.Secondary">Document ID</MudText></MudItem>
            <MudItem xs="6" sm="3"><MudText>@_po.DocumentId.Value</MudText></MudItem>
            
            <MudItem xs="6" sm="3"><MudText Typo="Typo.subtitle2" Color="Color.Secondary">Date</MudText></MudItem>
            <MudItem xs="6" sm="3"><MudText>@_po.OrderDate.ToString("yyyy-MM-dd")</MudText></MudItem>

            <MudItem xs="6" sm="3"><MudText Typo="Typo.subtitle2" Color="Color.Secondary">Supplier</MudText></MudItem>
            <MudItem xs="6" sm="3"><MudText>@_po.Supplier?.Name</MudText></MudItem>

            <MudItem xs="6" sm="3"><MudText Typo="Typo.subtitle2" Color="Color.Secondary">Status</MudText></MudItem>
            <MudItem xs="6" sm="3">
                <MudChip T="string" Color="@GetStatusColor(_po.Status)" Size="Size.Small">@_po.Status.ToString()</MudChip>
            </MudItem>

            <MudItem xs="6" sm="3"><MudText Typo="Typo.subtitle2" Color="Color.Secondary">Total Amount</MudText></MudItem>
            <MudItem xs="6" sm="3"><MudText>@_po.TotalAmount.ToString("C")</MudText></MudItem>

            <MudItem xs="6" sm="3"><MudText Typo="Typo.subtitle2" Color="Color.Secondary">Tax</MudText></MudItem>
            <MudItem xs="6" sm="3"><MudText>@_po.TaxAmount.ToString("C")</MudText></MudItem>

            <MudItem xs="6" sm="3"><MudText Typo="Typo.subtitle2" Color="Color.Secondary">Calculation</MudText></MudItem>
            <MudItem xs="6" sm="3"><MudText>v@_po.CalculationVersion, @_po.CurrencyScale decimals</MudText></MudItem>

            <MudItem xs="6" sm="3"><MudText Typo="Typo.subtitle2" Color="Color.Secondary">Commercial version</MudText></MudItem>
            <MudItem xs="6" sm="3"><MudText>v@_po.CommercialVersion (approved: @(_po.ApprovedCommercialVersion?.ToString() ?? "never"))</MudText></MudItem>

            @if (!string.IsNullOrWhiteSpace(_po.DeliveryTerms))
            {
                <MudItem xs="6" sm="3"><MudText Typo="Typo.subtitle2" Color="Color.Secondary">Delivery terms</MudText></MudItem>
                <MudItem xs="6" sm="9"><MudText>@_po.DeliveryTerms</MudText></MudItem>
            }
        </MudGrid>
    </MudPaper>

    <MudText Typo="Typo.h6" HtmlTag="h2" Class="mb-3">Line Items</MudText>

    @if (_progress is not null)
    {
        <MudPaper Elevation="1" Class="pa-4 my-4" aria-label="Purchase-order line progress">
            <MudText Typo="Typo.h6" HtmlTag="h2">Line fulfillment progress</MudText>
            <MudText Typo="Typo.body2" Class="mt-2">
                Lifecycle: @_progress.LifecycleStatus. Progress: @PurchaseOrderProgressPresentation.GetStateLabel(_progress.ProgressState).
                Received @_progress.ReceivedQuantity of @_progress.OrderedQuantity ordered units; @_progress.OutstandingQuantity outstanding;
                @_progress.AcceptedQuantity accepted, @_progress.RejectedQuantity rejected, and @_progress.AwaitingInspectionQuantity awaiting inspection.
            </MudText>
            <MudProgressLinear Value="@PurchaseOrderProgressPresentation.GetReceivedPercent(_progress)"
                               Color="Color.Primary"
                               Class="my-3"
                               aria-label="Received quantity progress" />
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-3">
                Line quantities are progress metadata only. This view does not create goods receipts or post stock or GRNI.
            </MudAlert>
            @if (_progress.Lines.Count == 0)
            {
                <MudText Color="Color.Secondary">No purchase-order lines are available for progress.</MudText>
            }
            else
            {
                <MudTable Items="@_progress.Lines" Dense="true" Hover="true" Striped="true"
                          Breakpoint="Breakpoint.Xs" Elevation="0" aria-label="Purchase-order line obligations">
                    <HeaderContent>
                        <MudTh>Item</MudTh>
                        <MudTh Style="text-align:right">Ordered</MudTh>
                        <MudTh Style="text-align:right">Received</MudTh>
                        <MudTh Style="text-align:right">Accepted</MudTh>
                        <MudTh Style="text-align:right">Rejected</MudTh>
                        <MudTh Style="text-align:right">Awaiting inspection</MudTh>
                        <MudTh Style="text-align:right">Outstanding</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Item">@context.ItemCode - @context.ItemDescription</MudTd>
                        <MudTd DataLabel="Ordered" Style="text-align:right">@context.OrderedQuantity</MudTd>
                        <MudTd DataLabel="Received" Style="text-align:right">@context.ReceivedQuantity</MudTd>
                        <MudTd DataLabel="Accepted" Style="text-align:right">@context.AcceptedQuantity</MudTd>
                        <MudTd DataLabel="Rejected" Style="text-align:right">@context.RejectedQuantity</MudTd>
                        <MudTd DataLabel="Awaiting inspection" Style="text-align:right">@context.AwaitingInspectionQuantity</MudTd>
                        <MudTd DataLabel="Outstanding" Style="text-align:right">@context.OutstandingQuantity</MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </MudPaper>
    }

    <MudTable Items="@_po.OrderDetails" Dense="true" Hover="true" Striped="true" Elevation="1">
        <HeaderContent>
            <MudTh>Item</MudTh>
            <MudTh Style="text-align:right">Quantity</MudTh>
            <MudTh Style="text-align:right">Unit Price</MudTh>
            <MudTh Style="text-align:right">Discount</MudTh>
            <MudTh Style="text-align:right">Tax</MudTh>
            <MudTh Style="text-align:right">Total</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Item">@context.Item?.ItemCode - @context.Item?.Description</MudTd>
            <MudTd DataLabel="Quantity" Style="text-align:right">@context.Quantity</MudTd>
            <MudTd DataLabel="Unit Price" Style="text-align:right">@context.UnitPrice.ToString("C")</MudTd>
            <MudTd DataLabel="Discount" Style="text-align:right">@context.DiscountAmount.ToString("C")</MudTd>
            <MudTd DataLabel="Tax" Style="text-align:right">@context.TaxAmount.ToString("C")</MudTd>
            <MudTd DataLabel="Total" Style="text-align:right">@context.GrossAmount.ToString("C")</MudTd>
        </RowTemplate>
    </MudTable>

    <MudText Typo="Typo.h6" HtmlTag="h2" Class="mt-4 mb-3">@L["Purchase-order status history"]</MudText>
    @if (_statusHistory.Count == 0)
    {
        <MudText Color="Color.Secondary">@L["No purchase-order status changes have been recorded."]</MudText>
    }
    else
    {
        <MudTable Items="@_statusHistory" Dense="true" Hover="true" Striped="true" Elevation="1" Breakpoint="Breakpoint.Xs" aria-label="@L["Purchase-order status history"]">
            <HeaderContent>
                <MudTh>@L["Previous status"]</MudTh>
                <MudTh>@L["New status"]</MudTh>
                <MudTh>@L["Changed by"]</MudTh>
                <MudTh>@L["Changed at (UTC)"]</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="@L["Previous status"]">@context.PreviousStatus</MudTd>
                <MudTd DataLabel="@L["New status"]">@context.Status</MudTd>
                <MudTd DataLabel="@L["Changed by"]">@context.Actor</MudTd>
                <MudTd DataLabel="@L["Changed at (UTC)"]">@context.TimestampUtc.ToString("yyyy-MM-dd HH:mm:ss 'UTC'")</MudTd>
            </RowTemplate>
        </MudTable>
    }

    <div class="document-actions mt-4 d-flex gap-2">
        @if (_po.Status == PurchaseOrderStatus.Pending)
        {
            <MudButton Class="document-action"
                       Disabled="@(_isUpdatingStatus || _showStatusReload)"
                       Variant="Variant.Filled"
                       Color="Color.Success"
                       OnClick="@(() => UpdateStatus(PurchaseOrderStatus.Approved))">
                Approve
            </MudButton>
            <MudButton Class="document-action"
                       Disabled="@(_isUpdatingStatus || _showStatusReload)"
                       Variant="Variant.Filled"
                       Color="Color.Error"
                       OnClick="@(() => UpdateStatus(PurchaseOrderStatus.Cancelled))">
                Cancel PO
            </MudButton>
        }
        @if (_po.Status == PurchaseOrderStatus.Approved)
        {
            <MudButton Class="document-action"
                       Disabled="@(_isUpdatingStatus || _showStatusReload)"
                       Variant="Variant.Outlined"
                       Color="Color.Warning"
                       Href="@($"/PurchaseOrders/Amend/{_po.Id}")">
                Amend commercial terms
            </MudButton>
        }
        @if (_po.Status is PurchaseOrderStatus.Submitted or PurchaseOrderStatus.Approved)
        {
            <MudButton Class="document-action"
                       Disabled="@(_isUpdatingStatus || _showStatusReload)"
                       Variant="Variant.Outlined"
                       Color="Color.Error"
                       OnClick="@(() => UpdateStatus(PurchaseOrderStatus.Voided))">
                Void PO
            </MudButton>
        }
        <MudButton Class="document-action" Href="/PurchaseOrders" Variant="Variant.Outlined" Color="Color.Secondary">Back to List</MudButton>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private PurchaseOrder? _po;
    private PurchaseOrderReceivingProgress? _progress;
    private IReadOnlyList<PurchaseOrderStatusHistoryEntry> _statusHistory = Array.Empty<PurchaseOrderStatusHistoryEntry>();
    private bool _isUpdatingStatus;
    private bool _showStatusReload;
    private bool _focusStatusFeedback;
    private ElementReference _statusFeedbackFocusTarget;
    private string? _statusFeedback;
    private Severity _statusFeedbackSeverity = Severity.Info;

    private string StatusFeedbackRole => _statusFeedbackSeverity == Severity.Error ? "alert" : "status";
    private string StatusFeedbackLive => _statusFeedbackSeverity == Severity.Error ? "assertive" : "polite";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusStatusFeedback)
        {
            _focusStatusFeedback = false;
            await _statusFeedbackFocusTarget.FocusAsync();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var principal = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        if (!await CurrentUserAuthorization.IsTenantAdministratorAsync(principal))
        {
            return;
        }

        _po = await POService.GetByIdAsync(Id);
        if (_po is not null)
        {
            _progress = await POService.GetReceivingProgressAsync(_po.Id);
            _statusHistory = await POService.GetStatusHistoryAsync(_po.Id);
        }
    }

    private Color GetStatusColor(PurchaseOrderStatus status)
    {
        return status switch
        {
            PurchaseOrderStatus.Pending => Color.Warning,
            PurchaseOrderStatus.Approved => Color.Success,
            PurchaseOrderStatus.Received => Color.Info,
            PurchaseOrderStatus.Cancelled => Color.Error,
            _ => Color.Default
        };
    }

    private async Task UpdateStatus(PurchaseOrderStatus newStatus)
    {
        if (_po is null || _isUpdatingStatus || _showStatusReload)
        {
            return;
        }

        _isUpdatingStatus = true;
        _showStatusReload = false;
        SetStatusFeedback(L["Updating purchase-order status…"], Severity.Info);
        try
        {
            var principal = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
            if (!await CurrentUserAuthorization.IsTenantAdministratorAsync(principal))
            {
                SetStatusFeedback(
                    L["Tenant administrator access is required for tenant-wide purchase orders."],
                    Severity.Error);
                return;
            }

            var actorId = principal.FindFirstValue(ClaimTypes.NameIdentifier);
            if (string.IsNullOrWhiteSpace(actorId))
            {
                SetStatusFeedback(
                    L["The authenticated user identity is unavailable. Sign in again before changing this purchase order."],
                    Severity.Error);
                return;
            }

            var purchaseOrderId = _po.Id;
            await POService.UpdateStatusAsync(
                purchaseOrderId,
                newStatus.ToString(),
                new PurchaseOrderStatusActor(actorId, principal.Identity?.Name));
            _po = await POService.GetByIdAsync(purchaseOrderId);
            _progress = _po is null
                ? null
                : await POService.GetReceivingProgressAsync(purchaseOrderId);
            _statusHistory = _po is null
                ? Array.Empty<PurchaseOrderStatusHistoryEntry>()
                : await POService.GetStatusHistoryAsync(purchaseOrderId);
            SetStatusFeedback(L["Purchase-order status updated."], Severity.Success);
        }
        catch (Exception exception)
        {
            SetStatusUpdateFailure(exception);
        }
        finally
        {
            _isUpdatingStatus = false;
        }
    }

    private void SetStatusUpdateFailure(Exception exception)
    {
        var (messageKey, severity) = PurchaseOrderStatusPresentation.GetFailureFeedback(exception) switch
        {
            PurchaseOrderStatusUpdateFailureKind.ConcurrencyConflict =>
                (
                    "The purchase order changed while you were viewing it. Reload the current purchase order before trying again.",
                    Severity.Error),
            PurchaseOrderStatusUpdateFailureKind.Rejected =>
                (
                    "The status change was not accepted. Reload the current purchase order and review its status before taking another action.",
                    Severity.Warning),
            _ =>
                (
                    "We could not confirm the current purchase-order status. Reload the latest details before trying again.",
                    Severity.Error)
        };

        SetStatusFeedback(L[messageKey], severity, offerReload: true);
    }

    private Task ReloadCurrentPurchaseOrder()
    {
        if (_isUpdatingStatus)
        {
            return Task.CompletedTask;
        }

        _isUpdatingStatus = true;
        _showStatusReload = false;
        SetStatusFeedback(L["Reloading purchase-order details…"], Severity.Info);
        Nav.NavigateTo(Nav.Uri, forceLoad: true);
        return Task.CompletedTask;
    }

    private void SetStatusFeedback(string message, Severity severity, bool offerReload = false)
    {
        _statusFeedback = message;
        _statusFeedbackSeverity = severity;
        _showStatusReload = offerReload;
        _focusStatusFeedback = true;
    }
}
