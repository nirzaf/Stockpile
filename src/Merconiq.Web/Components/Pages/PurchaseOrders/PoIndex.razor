@page "/PurchaseOrders"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Merconiq.Web.Security
@attribute [Authorize(Policy = CapabilityPolicies.TenantAdministrator)]
@inject IPurchaseOrderService POService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ICurrentUserAuthorization CurrentUserAuthorization
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JS

<PageTitle>Purchase Orders</PageTitle>

@if (_message is not null)
{
    <MudAlert Severity="Severity.Warning" Class="mb-3">@_message</MudAlert>
}

<div class="d-flex justify-space-between align-center mb-4">
    <MudText Typo="Typo.h4" Color="Color.Primary">Purchase Orders</MudText>
    <div class="d-flex gap-2">
        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="ExportToCsv">Export CSV</MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Info" OnClick="ExportToExcel">Export Excel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/PurchaseOrders/Create">New Purchase Order</MudButton>
    </div>
</div>

<MudTable Items="@_orders" Dense="true" Hover="true" Striped="true" Filter="new Func<PurchaseOrder,bool>(FilterFunc)">
    <ToolBarContent>
        <MudSpacer />
        <MudTextField @bind-Value="_searchString" Placeholder="Search" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
    </ToolBarContent>
    <HeaderContent>
        <MudTh><MudTableSortLabel SortBy="new Func<PurchaseOrder, object>(x=>x.PONumber)">PO Number</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel SortBy="new Func<PurchaseOrder, object>(x=>x.OrderDate)">Date</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel SortBy="new Func<PurchaseOrder, object>(x=>x.Supplier?.Name ?? string.Empty)">Supplier</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel SortBy="new Func<PurchaseOrder, object>(x=>x.Status)">Status</MudTableSortLabel></MudTh>
        <MudTh Style="text-align:right"><MudTableSortLabel SortBy="new Func<PurchaseOrder, object>(x=>x.TotalAmount)">Total</MudTableSortLabel></MudTh>
        <MudTh Style="text-align:right">Actions</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="PO Number">@context.PONumber</MudTd>
        <MudTd DataLabel="Date">@context.OrderDate.ToString("yyyy-MM-dd")</MudTd>
        <MudTd DataLabel="Supplier">@context.Supplier?.Name</MudTd>
        <MudTd DataLabel="Status">
            <MudChip T="string" Color="@GetStatusColor(context.Status)" Size="Size.Small">@context.Status.ToString()</MudChip>
        </MudTd>
        <MudTd DataLabel="Total" Style="text-align:right">@context.TotalAmount.ToString("C")</MudTd>
        <MudTd DataLabel="Actions" Style="text-align:right">
            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info" Href="@($"/PurchaseOrders/Details/{context.Id}")" Class="mr-2">Details</MudButton>
            @if (context.Status is PurchaseOrderStatus.Draft or PurchaseOrderStatus.Pending)
            {
                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" OnClick="@(() => DeletePO(context))">Cancel</MudButton>
            }
        </MudTd>
    </RowTemplate>
    <PagerContent>
        <MudTablePager />
    </PagerContent>
</MudTable>

@code {
    private IEnumerable<PurchaseOrder> _orders = new List<PurchaseOrder>();
    private string _searchString = "";
    private string? _message;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        if (!await IsTenantAdministratorAsync())
        {
            _orders = [];
            _message = "Purchase orders remain tenant-scoped until company ownership is implemented; tenant administrator access is required.";
            return;
        }

        _message = null;
        _orders = await POService.GetAllAsync();
    }

    private Color GetStatusColor(PurchaseOrderStatus status)
    {
        return status switch
        {
            PurchaseOrderStatus.Pending => Color.Warning,
            PurchaseOrderStatus.Approved => Color.Success,
            PurchaseOrderStatus.Received => Color.Info,
            PurchaseOrderStatus.Cancelled or PurchaseOrderStatus.Voided => Color.Error,
            _ => Color.Default
        };
    }

    private bool FilterFunc(PurchaseOrder element) => FilterFunc(element, _searchString);

    private bool FilterFunc(PurchaseOrder element, string searchString)
    {
        if (string.IsNullOrWhiteSpace(searchString)) return true;
        if (element.PONumber.Contains(searchString, StringComparison.OrdinalIgnoreCase)) return true;
        if (element.Supplier?.Name?.Contains(searchString, StringComparison.OrdinalIgnoreCase) == true) return true;
        return false;
    }

    private async Task ExportToCsv()
    {
        if (!await IsTenantAdministratorAsync())
        {
            Snackbar.Add("Tenant administrator access is required to export tenant-wide purchase orders.", Severity.Error);
            return;
        }

        var bytes = ExportFileBuilder.CreateCsv(ExportHeaders, ExportRows());
        await JS.InvokeVoidAsync("downloadFile", "PurchaseOrders_Export.csv", "text/csv", bytes);
        Snackbar.Add("Exported successfully", Severity.Success);
    }

    private async Task ExportToExcel()
    {
        if (!await IsTenantAdministratorAsync())
        {
            Snackbar.Add("Tenant administrator access is required to export tenant-wide purchase orders.", Severity.Error);
            return;
        }

        var bytes = ExportFileBuilder.CreateExcel("Purchase Orders", ExportHeaders, ExportRows());
        await JS.InvokeVoidAsync("downloadFile", "PurchaseOrders_Export.xlsx", "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", bytes);
        Snackbar.Add("Exported successfully", Severity.Success);
    }

    private IEnumerable<object?[]> ExportRows() => _orders.Select(order => new object?[]
    {
        order.PONumber, order.OrderDate, order.Supplier?.Name, order.Status, order.TotalAmount
    });

    private static readonly string[] ExportHeaders =
        ["PO Number", "Order Date", "Supplier", "Status", "Total Amount"];

    private async Task DeletePO(PurchaseOrder po)
    {
        bool? result = await DialogService.ShowMessageBoxAsync(
            "Warning", 
            $"Cancel purchase order {po.PONumber}? Its number and audit history will be retained.",
            yesText: "Cancel PO", cancelText: "Keep PO");

        if (result == true)
        {
            try
            {
                if (!await IsTenantAdministratorAsync())
                {
                    Snackbar.Add("Tenant administrator access is required to change tenant-wide purchase orders.", Severity.Error);
                    return;
                }

                await POService.DeleteAsync(po.Id);
                Snackbar.Add("Purchase order cancelled; its number and history were retained.", Severity.Success);
                await LoadData();
            }
            catch (Exception ex)
            {
                Snackbar.Add(ex.Message, Severity.Error);
            }
        }
    }

    private async Task<bool> IsTenantAdministratorAsync()
    {
        var principal = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        return await CurrentUserAuthorization.IsTenantAdministratorAsync(principal);
    }
}
