{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning"
    }
  },
  "Tenancy": {
    "HostTenants": {
      "localhost": "test-tenant",
      "127.0.0.1": "test-tenant",
      "::1": "test-tenant"
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "https://trusted.example"
    ]
  },
  "Forecasting": {
    "Enabled": true,
    "Implementation": "managed-moving-average",
    "MaxForecastHorizonDays": 90,
    "MaxHistoricalDays": 365
  }
}
