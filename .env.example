# === Inventory Management System — Environment Variables ===
# Copy this file to .env and customize values for your deployment.

# ASP.NET Core
ASPNETCORE_ENVIRONMENT=Production

# PostgreSQL
DB_NAME=InventoryDB
DB_USER=postgres
DB_PASSWORD=
# DB_PORT=5432

# Explicit administrator bootstrap (used only by `--bootstrap-admin`, never by web startup)
BOOTSTRAP_ADMIN_TENANT=default
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# JWT signing key (at least 32 bytes; generate and keep this secret)
JWT_SECRET=

# Application
# APP_PORT=8080
# DEBUG_PORT=5000

# Docker — set to true to disable HTTPS (recommended behind reverse proxy)
# DISABLE_HTTPS is set automatically in docker-compose.yml
