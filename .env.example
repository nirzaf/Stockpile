# === Inventory Management System — Environment Variables ===
# Copy this file to .env and customize values for your deployment.

# Compose mode is selected explicitly with docker-compose.yml (production) or
# docker-compose.dev.yml (local development); do not rely on an override file.

# PostgreSQL
DB_NAME=InventoryDB
DB_USER=postgres
DB_PASSWORD=
# DB_PORT=5432

# Admin account (required by the explicit Development Compose path only)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# JWT signing key (at least 32 bytes; generate and keep this secret)
JWT_SECRET=

# Application
# APP_PORT=8080
# DEBUG_PORT=5000

# Docker — set to true to disable HTTPS (recommended behind reverse proxy)
# DISABLE_HTTPS is set automatically in docker-compose.yml
