@page "/Stock/Transfer"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject IStockService StockService
@inject IItemService ItemService
@inject ILocationService LocationService
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<PageTitle>Transfer Stock</PageTitle>

<MudText Typo="Typo.h4" Color="Color.Primary" Class="mb-3">Transfer Stock</MudText>
<MudDivider Class="mb-4" />

<MudGrid>
    <MudItem xs="12" md="6">
        <MudPaper Elevation="1" Class="pa-4">
            <MudForm @ref="_form" @bind-IsValid="@_success">
                <MudSelect T="int" @bind-Value="_itemId" Label="Item" AnchorOrigin="Origin.BottomCenter" Required="true" RequiredError="Item is required." Class="mb-3">
                    <MudSelectItem T="int" Value="0">-- Select Item --</MudSelectItem>
                    @foreach (var item in _items)
                    {
                        <MudSelectItem T="int" Value="@item.Id">@item.ItemCode - @item.Description</MudSelectItem>
                    }
                </MudSelect>

                <MudSelect T="int" @bind-Value="_fromLocationId" Label="From Location" AnchorOrigin="Origin.BottomCenter" Required="true" RequiredError="Source Location is required." Class="mb-3">
                    <MudSelectItem T="int" Value="0">-- Select Source Location --</MudSelectItem>
                    @foreach (var loc in _locations)
                    {
                        <MudSelectItem T="int" Value="@loc.Id">@loc.Name</MudSelectItem>
                    }
                </MudSelect>

                <MudSelect T="int" @bind-Value="_toLocationId" Label="To Location" AnchorOrigin="Origin.BottomCenter" Required="true" RequiredError="Destination Location is required." Class="mb-3">
                    <MudSelectItem T="int" Value="0">-- Select Destination Location --</MudSelectItem>
                    @foreach (var loc in _locations)
                    {
                        <MudSelectItem T="int" Value="@loc.Id">@loc.Name</MudSelectItem>
                    }
                </MudSelect>

                <MudNumericField @bind-Value="_quantity" Label="Quantity" Min="1" Required="true" RequiredError="Quantity must be at least 1." Class="mb-3" />
                <MudTextField @bind-Value="_notes" Label="Notes" Lines="2" Class="mb-3" />

                <div class="d-flex gap-2 mt-4">
                    <MudButton Variant="Variant.Filled" Color="Color.Info" OnClick="SubmitForm">Transfer Stock</MudButton>
                    <MudButton Href="/Stock/Index" Variant="Variant.Outlined" Color="Color.Secondary">Cancel</MudButton>
                </div>
            </MudForm>
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private MudForm? _form;
    private bool _success;

    private int _itemId;
    private int _fromLocationId;
    private int _toLocationId;
    private int _quantity = 1;
    private string? _notes;

    private IEnumerable<Item> _items = new List<Item>();
    private IEnumerable<Location> _locations = new List<Location>();

    protected override async Task OnInitializedAsync()
    {
        _items = await ItemService.GetAllAsync();
        _locations = await LocationService.GetAllAsync();
    }

    private async Task SubmitForm()
    {
        await _form!.ValidateAsync();
        if (_form.IsValid && _itemId > 0 && _fromLocationId > 0 && _toLocationId > 0)
        {
            if (_fromLocationId == _toLocationId)
            {
                Snackbar.Add("Source and destination locations must be different.", Severity.Warning);
                return;
            }

            try
            {
                await StockService.TransferStockAsync(_itemId, _fromLocationId, _toLocationId, _quantity, _notes);
                Snackbar.Add($"Transferred {_quantity} units successfully.", Severity.Success);
                Nav.NavigateTo("/Stock/Index");
            }
            catch (Exception ex)
            {
                Snackbar.Add(ex.Message, Severity.Error);
            }
        }
        else if (_itemId == 0) Snackbar.Add("Please select an item.", Severity.Warning);
        else if (_fromLocationId == 0) Snackbar.Add("Please select a source location.", Severity.Warning);
        else if (_toLocationId == 0) Snackbar.Add("Please select a destination location.", Severity.Warning);
    }
}
