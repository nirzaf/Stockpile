@using Microsoft.AspNetCore.Identity
@using Merconiq.Infrastructure.Data
@using MudBlazor
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Merconiq</title>
    <link href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700&display=swap" rel="stylesheet" />
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <MudThemeProvider/>
    <MudDialogProvider/>
    <MudSnackbarProvider/>

    <MudLayout>
        <MudAppBar Elevation="1">
            <MudText Typo="Typo.h6" Class="ml-3">Merconiq</MudText>
            <MudSpacer/>
            @if (SignInManager.IsSignedIn(User))
            {
                <MudText Typo="Typo.body2" Class="d-none d-md-flex mr-4">
                    @UserManager.GetUserAsync(User).Result?.DisplayName
                </MudText>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Outlined" Color="Color.Inherit" Size="Size.Small" StartIcon="@Icons.Material.Filled.Logout">
                        Logout
                    </MudButton>
                </form>
            }
        </MudAppBar>
        @if (SignInManager.IsSignedIn(User))
        {
            <MudNavMenu>
                <MudNavLink Href="/" Icon="@Icons.Material.Filled.Dashboard" Match="NavLinkMatch.All">Dashboard</MudNavLink>
                <MudNavLink Href="/Items" Icon="@Icons.Material.Filled.Inventory">Items</MudNavLink>
                <MudNavGroup Text="Stock" Icon="@Icons.Material.Filled.Warehouse" Expanded="false">
                    <MudNavLink Href="/Stock/Index" Icon="@Icons.Material.Filled.Visibility">View Stock</MudNavLink>
                    <MudNavLink Href="/Stock/Receive" Icon="@Icons.Material.Filled.AddCircle">Receive Stock</MudNavLink>
                    <MudNavLink Href="/Stock/Transfer" Icon="@Icons.Material.Filled.SwapHoriz">Transfer Stock</MudNavLink>
                    <MudNavLink Href="/Stock/Sell" Icon="@Icons.Material.Filled.ShoppingCart">Sell Stock</MudNavLink>
                    <MudNavLink Href="/Stock/Transactions" Icon="@Icons.Material.Filled.History">Transactions</MudNavLink>
                </MudNavGroup>
                <MudNavLink Href="/PurchaseOrders" Icon="@Icons.Material.Filled.Receipt">Purchase Orders</MudNavLink>
                <MudNavLink Href="/Suppliers" Icon="@Icons.Material.Filled.Business">Suppliers</MudNavLink>
                <MudNavLink Href="/Locations" Icon="@Icons.Material.Filled.LocationOn">Locations</MudNavLink>
            </MudNavMenu>
        }
        <MudMainContent>
            <MudContainer MaxWidth="MaxWidth.Large" Class="my-4">
                @if (TempData["Success"] != null)
                {
                    <MudAlert Severity="Severity.Success" Class="mb-3" Dense="true">@TempData["Success"]</MudAlert>
                }
                @if (TempData["Error"] != null)
                {
                    <MudAlert Severity="Severity.Error" Class="mb-3" Dense="true">@TempData["Error"]</MudAlert>
                }
                @RenderBody()
            </MudContainer>
        </MudMainContent>
        <MudFooter>
            <MudText Typo="Typo.caption" Align="Align.Center" Class="pa-3">
                &copy; @DateTime.Now.Year - Merconiq
            </MudText>
        </MudFooter>
    </MudLayout>

    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
